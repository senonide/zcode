.{
    .name = .tree_sitter,
    .fingerprint = 0x841224b47f8817f2,
    .version = "0.26.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // tree-sitter C core, vendored alongside these bindings so the build is
        // fully offline (was a git+url fetch; the test-only tree-sitter-c dep was
        // dropped — it is never fetched when used as a dependency anyway).
        .tree_sitter = .{ .path = "../tree-sitter" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
